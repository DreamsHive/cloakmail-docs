{
  "name": "cloakmail-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "preview": "NODE_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "NODE_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.16.0",
    "fumadocs-core": "^16.4.9",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-ui": "^16.4.9",
    "lucide-react": "^0.563.0",
    "next": "16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.61.0"
  }
}
